{
  "expo": {
    "name": "Chestnut",
    "slug": "chestnut",
    "version": "2.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131620",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pochyly.chestnut"
    },
    "platforms": [
      "ios"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131620"
        }
      ],
      "expo-font"
    ]
  }
}
